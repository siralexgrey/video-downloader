[Unit]
Description=Telegram Video Downloader Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/video-downloader
Environment=TELEGRAM_BOT_TOKEN=REPLACE_ME
ExecStart=/home/ubuntu/video-downloader/.venv/bin/python main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
